# Local FLUX / ComfyUI
COMFYUI_BASE_URL=http://127.0.0.1:8188
FLUXCTL_BIN=/Users/uhuru/dev/ltx/bin/fluxctl

# Instagram API (professional account)
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_API_VERSION=v26.0

# Media hosting: cloudinary or static
MEDIA_HOST=cloudinary

# Cloudinary signed upload
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=instacards

# Alternative: directory already exposed through a public HTTPS URL
# MEDIA_HOST=static
# MEDIA_PUBLIC_DIR=/absolute/path/to/public/instacards
# MEDIA_PUBLIC_BASE_URL=https://example.com/instacards

